#!/usr/bin/env bash
# Commit everything and push it to GitHub. With --bump, also raise the version
# and tag it, which makes GitHub build the installers for every platform and
# publish them. Installed copies of the app then update themselves.
#
#   ./push "what changed"                  commit and push
#   ./push "what changed" --bump           ...and release (0.1.0 -> 0.1.1)
#   ./push "what changed" --bump minor     0.1.3 -> 0.2.0
#   ./push "what changed" --bump major     0.4.1 -> 1.0.0
#   ./push "what changed" --bump 1.2.3     an exact version
#   add --dry-run to see what would happen without changing anything
#
# The message becomes the commit message and, for a release, the release notes.
set -euo pipefail
cd "$(dirname "$0")"

message=""
bump=""
dry_run=false
while [ $# -gt 0 ]; do
  case "$1" in
    --bump)
      bump="patch"
      if [ $# -gt 1 ] && [[ "$2" =~ ^(patch|minor|major|[0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
        bump="$2"
        shift
      fi
      ;;
    --dry-run) dry_run=true ;;
    -h | --help)
      sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    -*)
      echo "Unknown option: $1 (try ./push --help)" >&2
      exit 2
      ;;
    *)
      if [ -n "$message" ]; then
        echo "Put the whole message in one pair of quotes." >&2
        exit 2
      fi
      message="$1"
      ;;
  esac
  shift
done

fail() {
  echo "push: $1" >&2
  exit 1
}

[ -n "$message" ] || fail 'say what changed, e.g. ./push "Fix tag editor" --bump'
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "this folder is not a git repository yet (git init)."
branch=$(git symbolic-ref --quiet --short HEAD) || fail "not on a branch."
git remote get-url origin >/dev/null 2>&1 || $dry_run || fail "there is no GitHub repo linked yet (no 'origin' remote)."

next=""
tag=""
if [ -n "$bump" ]; then
  next=$(node scripts/bump-version.mjs "$bump" --dry-run) || exit 1
  tag="v$next"
  git rev-parse -q --verify "refs/tags/$tag" >/dev/null && fail "$tag already exists."
  # A release without the signing key fails ten minutes into the build; catch it here.
  if ! $dry_run && command -v gh >/dev/null 2>&1; then
    gh secret list 2>/dev/null | grep -q '^TAURI_SIGNING_PRIVATE_KEY' ||
      fail "the repo has no TAURI_SIGNING_PRIVATE_KEY secret, so the release could not be signed. Add it with:
       gh secret set TAURI_SIGNING_PRIVATE_KEY < ~/.tauri/dubplate-updater.key"
  fi
fi

if $dry_run; then
  echo "Would commit on '$branch': $message"
  git status --short | sed 's/^/    /'
  if [ -n "$tag" ]; then
    echo "Would raise the version $(node -p "require('./package.json').version") -> $next, tag it $tag and push the tag (starts a release)."
  fi
  echo "Would push '$branch' to origin."
  exit 0
fi

if [ -n "$bump" ]; then
  node scripts/bump-version.mjs "$bump" >/dev/null
fi

git add -A
if git diff --cached --quiet; then
  echo "Nothing new to commit."
else
  git commit --quiet -m "$message"
  echo "Committed: $message"
fi

if [ -n "$tag" ]; then
  git tag -a "$tag" -m "$message"
fi

git push --quiet -u origin "$branch"
echo "Pushed '$branch'."

if [ -n "$tag" ]; then
  git push --quiet origin "$tag"
  echo "Released $tag. GitHub is now building the installers (about 15 minutes);"
  echo "when it finishes, installed copies of the app pick the update up by themselves."
  if command -v gh >/dev/null 2>&1; then
    url=$(gh repo view --json url --jq .url 2>/dev/null || true)
    [ -n "$url" ] && echo "Progress: $url/actions"
  fi
fi
