          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 16
        }
      },
      {
        "label": "player",
        "title": "Wisp Player",
        "width": 300,
        "height": 392,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
