{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wisp",
        "width": 1080,
        "height": 740,
        "minWidth": 880,
        "minHeight": 580,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
